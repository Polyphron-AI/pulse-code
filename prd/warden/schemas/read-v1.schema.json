{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulse:warden:read-request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "credentialRef",
    "action",
    "resource",
    "taskRef",
    "attemptRef",
    "payload"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "credentialRef": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^urn:pulse:[A-Za-z0-9._-]{1,64}:credential:[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "action": {
      "const": "grafana.saved_query.read"
    },
    "resource": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^urn:pulse:[A-Za-z0-9._-]{1,64}:resource:[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "taskRef": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^urn:pulse:[A-Za-z0-9._-]{1,64}:task:[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "attemptRef": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^urn:pulse:[A-Za-z0-9._-]{1,64}:attempt:[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryRef", "lookbackSeconds"],
      "properties": {
        "queryRef": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^urn:pulse:[A-Za-z0-9._-]{1,64}:query:[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
        },
        "lookbackSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600,
          "multipleOf": 60
        }
      }
    }
  }
}
