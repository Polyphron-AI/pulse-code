{
  "contract": {
    "criteria": [
      {
        "id": "G1",
        "satisfied_by": [
          "T1",
          "T2",
          "T3",
          "T9"
        ],
        "text": "Users can create daily, weekday, weekly, monthly, quarterly, annual, and supported custom calendar recurrence with exact timezone previews."
      },
      {
        "id": "G2",
        "satisfied_by": [
          "T2",
          "T3",
          "T9"
        ],
        "text": "Existing elapsed intervals keep their prior semantics and do not convert without explicit user action."
      },
      {
        "id": "G3",
        "satisfied_by": [
          "T12",
          "T2",
          "T3"
        ],
        "text": "Restart, DST, catch-up, and overlap produce exactly one visible disposition per due occurrence."
      },
      {
        "id": "G4",
        "satisfied_by": [
          "T7",
          "T8"
        ],
        "text": "The global web/desktop board shows schedules from connected environments across all lifecycle states and required filters."
      },
      {
        "id": "G5",
        "satisfied_by": [
          "T10",
          "T7"
        ],
        "text": "Mobile provides equivalent schedule discovery, status, history, and valid controls."
      },
      {
        "id": "G6",
        "satisfied_by": [
          "T10",
          "T4",
          "T5",
          "T6",
          "T8"
        ],
        "text": "Full run history is immutable, paginated, authorized, and fetched on demand instead of riding shell subscriptions."
      },
      {
        "id": "G7",
        "satisfied_by": [
          "T10",
          "T6",
          "T7",
          "T8"
        ],
        "text": "Board controls use canonical orchestration commands and handle disconnected or mixed-version environments explicitly."
      },
      {
        "id": "G8",
        "satisfied_by": [
          "T11"
        ],
        "text": "Completed and Needs attention runs can notify an opted-in user without leaking prompt, output, diff, or credential data."
      },
      {
        "id": "G9",
        "satisfied_by": [
          "T10",
          "T4",
          "T5",
          "T6",
          "T7",
          "T8"
        ],
        "text": "Schedule list and history performance remain bounded for remote and mobile clients."
      },
      {
        "id": "G10",
        "satisfied_by": [
          "T10",
          "T11",
          "T12",
          "T3",
          "T5",
          "T8",
          "T9"
        ],
        "text": "Focused automated and authorized integrated receipts cover calendar correctness and the complete board journey."
      }
    ],
