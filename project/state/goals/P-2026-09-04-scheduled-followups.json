{
  "contract": {
    "criteria": [
      {
        "id": "G1",
        "satisfied_by": [
          "T1",
          "T10",
          "T3",
          "T8",
          "T9"
        ],
        "text": "An unambiguous request for one exact future date creates a one-off schedule with the displayed absolute time and IANA timezone."
      },
      {
        "id": "G2",
        "satisfied_by": [
          "T1",
          "T3",
          "T5"
        ],
        "text": "A schedule created from a thread returns to that same durable thread without changing its identity or origin."
      },
      {
        "id": "G3",
        "satisfied_by": [
          "T10",
          "T9"
        ],
        "text": "The user can invoke `/schedule` and the equivalent thread action on web, desktop, and mobile."
      },
      {
        "id": "G4",
        "satisfied_by": [
          "T10",
          "T8",
          "T9"
        ],
        "text": "Pulse asks Once or Repeat only when cadence is absent or ambiguous."
      },
      {
        "id": "G5",
        "satisfied_by": [
          "T12",
          "T6",
          "T7"
        ],
        "text": "Every provider can expose the Pulse schedule tools or report the unsupported capability without changing schedule truth."
      },
      {
        "id": "G6",
        "satisfied_by": [
          "T1",
          "T11",
          "T3",
          "T5"
        ],
        "text": "A one-off fires at most once, reaches Completed, survives restart/replay, and remains inspectable."
      },
      {
        "id": "G7",
        "satisfied_by": [
          "T3",
          "T5"
        ],
        "text": "Active-thread overlap and offline-host catch-up produce explicit deferred, started, skipped, or failed evidence rather than silence."
      },
      {
        "id": "G8",
        "satisfied_by": [
          "T1",
          "T13",
          "T2",
          "T3",
          "T4"
        ],
        "text": "Old schedules and clients keep working, and an old server cannot misinterpret native trigger fields."
      },
      {
        "id": "G9",
        "satisfied_by": [
          "T12",
          "T13",
          "T5"
        ],
        "text": "Existing run leashes, authentication probes, dirty-tree policy, checkpoint diffs, and remote server ownership remain enforced."
      },
      {
        "id": "G10",
        "satisfied_by": [
          "T10",
          "T11",
          "T12",
          "T13",
          "T9"
        ],
        "text": "Focused automated and authorized real-client receipts cover the complete creation-to-completion journey across applicable surfaces."
      }
    ],
